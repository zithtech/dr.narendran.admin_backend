{
  "name": "drnarendran-admin-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone Admin REST API for Dr Narendran medical suite",
  "type": "module",
  "engines": {
    "node": ">=22.11.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "migrate": "node --import tsx ./node_modules/node-pg-migrate/bin/node-pg-migrate.js --check-order false",
    "migrate:up": "npm run migrate -- up",
    "migrate:down": "npm run migrate -- down",
    "migrate:create": "npm run migrate -- create",
    "migrate:tenant": "node --import tsx ./node_modules/node-pg-migrate/bin/node-pg-migrate.js --check-order false --migrations-dir migrations-tenant",
    "migrate:tenant:up": "npm run migrate:tenant -- up",
    "migrate:tenant:down": "npm run migrate:tenant -- down",
    "migrate:tenant:create": "npm run migrate:tenant -- create",
    "verify": "npm run typecheck && npm run lint && npm test",
    "prepare": "husky"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1135.0",
    "@aws-sdk/s3-request-presigner": "^3.1135.0",
    "@google/generative-ai": "^0.24.1",
    "argon2": "0.45.1",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "firebase-admin": "^14.5.0",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.10",
    "pg": "8.23.0",
    "pino": "^10.3.1",
    "puppeteer": "^25.12.0",
    "socket.io": "^4.8.4",
    "xlsx": "^0.18.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "22.20.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "husky": "9.1.7",
    "jiti": "2.7.0",
    "lint-staged": "17.5.1",
    "node-pg-migrate": "9.0.0",
    "pino-pretty": "13.1.3",
    "prettier": "3.9.6",
    "supertest": "7.2.2",
    "tsc-alias": "1.9.5",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix --max-warnings=0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
