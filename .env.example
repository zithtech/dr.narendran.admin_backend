# ---------------------------------------------------------------------------
# Copy to .env and fill in real values:  cp .env.example .env
#
# Every variable here is validated by Zod in src/config/env.ts at import time.
# A missing or malformed value crashes the process on boot with a readable
# message, rather than letting the app run with `undefined` config.
# ---------------------------------------------------------------------------

# One of: development | test | production
NODE_ENV=development

# The mobile apps hardcode port 4000 in their .env files
# (http://10.0.2.2:4000/api on Android, http://localhost:4000/api on iOS),
# so changing this means changing both apps too.
PORT=4000

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# Full libpq connection string.
DATABASE_URL=postgresql://user:password@host:5432/drnarendranapp_dev

# Used only by `pnpm test`. MUST point at a different database than
# DATABASE_URL - the suite TRUNCATEs tables between tests.
TEST_DATABASE_URL=postgresql://user:password@host:5432/drnarendranapp_test

# Whether to negotiate TLS to Postgres. Leave false only when the server has
# ssl=off (check with `SHOW ssl;`) - pg fails the handshake outright against a
# non-TLS server, so this is not a "safe to leave on" flag.
DB_SSL=false

# Verify the server's certificate chain. Only meaningful when DB_SSL=true.
# Set to false ONLY for a self-signed cert you control; it disables the check
# that prevents man-in-the-middle interception.
DB_SSL_REJECT_UNAUTHORIZED=true

# Max pooled connections PER PROCESS. Keep well under the server's
# max_connections (see `SHOW max_connections;`) so migrations, psql sessions
# and other app instances can still connect.
DB_POOL_MAX=10

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------

# HMAC signing key for access tokens. Minimum 32 characters, enforced at boot.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotating this invalidates every issued token, logging all users out.
JWT_SECRET=replace-me-with-at-least-32-random-characters

# Access token lifetime. Long because the apps have no refresh-token flow -
# shortening this requires building /auth/refresh AND changing both apps.
JWT_EXPIRES_IN=7d

# ---------------------------------------------------------------------------
# Observability & network
# ---------------------------------------------------------------------------

# One of: fatal | error | warn | info | debug | trace
LOG_LEVEL=debug

# Comma-separated browser origins allowed to call this API. Empty = deny all
# cross-origin browser requests, which is correct today: the React Native apps
# are native and send no Origin header, so CORS never applies to them.
# Example: https://admin.example.com,http://localhost:5173
CORS_ORIGINS=

# Number of trusted reverse proxies in front of this app. 0 = none (direct).
# This must be exact: too high lets a client spoof X-Forwarded-For and evade
# the rate limiter entirely; too low rate-limits every user behind the proxy
# as if they shared one IP.
TRUST_PROXY_HOPS=0

# ---------------------------------------------------------------------------
# System Email (Nodemailer)
# ---------------------------------------------------------------------------
SYSTEM_EMAIL=system@example.com
SYSTEM_APP_PASSWORD=change_me
SYSTEM_HOST=smtp.example.com
SYSTEM_PORT=465
SYSTEM_SECURE=true

# ---------------------------------------------------------------------------
# Firebase Admin SDK (FCM Push Notifications)
# ---------------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Optional fallback to service-account.json path
# GOOGLE_APPLICATION_CREDENTIALS=

